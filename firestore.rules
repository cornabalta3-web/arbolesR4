rules_version = '2';

// Reglas de Caja Árboles: solo pueden entrar las cuentas de Google de la lista.
// Reemplazá los tres mails de ejemplo por los reales antes de publicar las reglas en Firebase.
service cloud.firestore {
  match /databases/{database}/documents {

    function permitido() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'mail-de-fran@gmail.com',
          'mail-de-rocio@gmail.com',
          'mail-de-balta@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if permitido();
    }
  }
}
